# Generate this file from your local config.yaml — never commit real values:
#
#   kubectl create secret generic llm-gateway-config \
#     --from-file=config.yaml=config.yaml \
#     --namespace llm-gateway --dry-run=client -o yaml > k8s/secret.yaml
#
apiVersion: v1
kind: Secret
metadata:
  name: llm-gateway-config
  namespace: llm-gateway
type: Opaque
data:
  config.yaml: <base64-encoded-config>
