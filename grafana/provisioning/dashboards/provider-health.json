{
  "uid": "llm-gateway-providers",
  "title": "LLM Gateway — Provider Health",
  "tags": ["llm-gateway"],
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate by Provider",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(llmgw_requests_total[1m])) by (provider)",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate by Provider (%)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "100 * sum(rate(llmgw_requests_total{status_code=~\"5..\"}[1m])) by (provider) / sum(rate(llmgw_requests_total[1m])) by (provider)",
          "legendFormat": "{{provider}} 5xx %"
        }
      ]
    },
    {
      "id": 3,
      "title": "Fallback Usage Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(llmgw_requests_total{provider!=\"openai\",provider!=\"cache\",status_code=\"200\"}[1m]))",
          "legendFormat": "Fallback successes/sec"
        }
      ]
    },
    {
      "id": 4,
      "title": "502 Bad Gateway Rate (all providers exhausted)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(llmgw_requests_total{status_code=\"502\"}[1m]))",
          "legendFormat": "502 rate/sec"
        }
      ]
    },
    {
      "id": 5,
      "title": "p99 Latency by Provider",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(llmgw_request_duration_seconds_bucket[1m])) by (le, provider))",
          "legendFormat": "p99 {{provider}}"
        }
      ]
    }
  ],
  "schemaVersion": 38
}
